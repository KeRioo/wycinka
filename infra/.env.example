# wycinka.app — przykładowe zmienne środowiskowe
# Skopiuj do .env i uzupełnij wartości.

# --- Domeny ---
# Główna domena aplikacji (wildcard dla subdomen)
DOMAIN=wycinka.app
# Opcjonalnie subdomena dla API (puste = ten sam host co frontend)
API_SUBDOMAIN=

# --- Porty (host -> kontener) ---
# API (FastAPI) — wystawiony bezpośrednio w dev, w prod schowany za Caddy
API_PORT=8000
# Web (Vite dev server) — tylko w dev compose
WEB_PORT=5173

# --- Cloudflare Tunnel ---
# ID tunelu (UUID z `cloudflared tunnel create wycinka`)
TUNNEL_ID=00000000-0000-0000-0000-000000000000
# Nazwa tunelu
TUNNEL_NAME=wycinka

# --- Storage ---
# Katalog na dane runtime (PMTiles, SQLite, backup)
# Na hostcie zamontowany do /app/data w kontenerze api
DATA_DIR=./data

# --- API runtime ---
# Przekazywane do kontenera api
APP_ENV=production
LOG_LEVEL=INFO

# --- CORS + auth (caddy) ---
# Origin CORS dla produkcji — dokładne dopasowanie Origin (przeglądarka).
# Rozwinięte w caddy do "Access-Control-Allow-Origin". W dev
# (APP_ENV=development) caddy fallbackuje na "*" i ta wartość jest ignorowana.
FRONTEND_ORIGIN=https://wycinka.app

# Basic auth (jeden user: `wycinka`) — tylko produkcja, całe site (web + api).
# Hash bcrypt. Generacja (patrz operational-runbook.md):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'twoje-haslo'
# Wklej wynik ($2a$14$...) tutaj. Brak hash = caddy odpowie 401 na wszystko.
AUTH_PASSWORD_HASH=

# --- ETL (egib_sync cron-container) ---
# Wywołanie sync co N sekund (domyślnie co dobe)
ETL_INTERVAL_SECONDS=86400
# Ile JSON raportow pipeline trzymac w data/.sync-ops
ETL_REPORT_KEEP=5
# Filtrowa powiaty po prefixie TERYT podczas downloadu
EGIB_DOWNLOAD_RETRIES=3

# Sync trigger (backend -> ETL subprocess). Puste = endpoint trigger zwraca SYNC_NOT_CONFIGURED.
WYCINKA_SYNC_COMMAND=python -m egib_sync
# Powiat dla sync wywołanego z backendu (TERYT powiatu, opcjonalnie)
ETL_POWIAT=
