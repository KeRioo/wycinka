# Caddyfile — wycinka.app
# Auto-HTTPS, reverse proxy, kompresja, CORS i basic auth.
#
# Zmienne środowiskowe (patrz infra/.env.example + operational-runbook.md):
#   DOMAIN              — domena site'u (default: localhost)
#   APP_ENV             — production | development
#   FRONTEND_ORIGIN     — dozwolony origin CORS dla prod (compose ustawia
#                         default na https://$DOMAIN; w Caddyfile: https://localhost)
#   AUTH_PASSWORD_HASH  — bcrypt z `caddy hash-password` (wymagany w prod)
#
# CORS: w prod origin z FRONTEND_ORIGIN (dokładne dopasowanie, nie `*`).
#       W dev (APP_ENV=development) fallback na `*`.
# Auth: w prod basic_auth na CAŁYM site (web + api). W dev bez hasła.
#       PMTiles działa z basic auth, bo frontend fetchuje PMTiles z tego
#       samego origin za Caddy — przeglądarka cache'uje sesję basic auth
#       (credentials same-origin) i dokleja do subsekwentnych zapytań.
#
# Snippety wybierane wg APP_ENV przez infra/caddy/entrypoint.sh (substytucja
# import {$VAR} nie działa — parser rozwija `import` przed substytucją env),
# dlatego nazwy snippetów muszą być zdefiniowane PRZED `import`.

(cors_production) {
	header {
		Access-Control-Allow-Origin "{$FRONTEND_ORIGIN:https://localhost}"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, Range"
		Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
		Access-Control-Max-Age "86400"
	}
	# Preflight: przeglądarka nie wysyła credentials na OPTIONS — odpowiadamy
	# 204 (handle, bo respond @matcher nie short-circuitował za handled-routing)
	@cors_preflight {
		method OPTIONS
	}
	handle @cors_preflight {
		respond 204
	}
}

(cors_development) {
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, Range"
		Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range, ETag"
		Access-Control-Max-Age "86400"
	}
	@cors_preflight {
		method OPTIONS
	}
	handle @cors_preflight {
		respond 204
	}
}

# --- Auth: produkcja — basic auth na całym site ---
# Hasło: AUTH_PASSWORD_HASH z `docker run --rm caddy:2-alpine caddy hash-password`.
# Jeśli zmienna nieustawiona — Caddy nie przyjmie poprawnego hasła (fail-fast
# przy próbie logowania; kompilacja przejdzie, trzeba ustawić env).
(auth_production) {
	# OPTIONS (preflight) bez auth — przeglądarka nie wysyła credentials na preflight
	@auth_preflight {
		method OPTIONS
	}
	@not_login_preflight {
		not method OPTIONS
	}
	basic_auth @not_login_preflight {
		wycinka {$AUTH_PASSWORD_HASH:VALIDATE-MISSING-AUTH_PASSWORD_HASH}
	}
}

# --- Auth: development — bez hasła ---
(auth_development) {
}

{
	admin 127.0.0.1:2019
}

{$DOMAIN:localhost} {
	encode gzip zstd

	import {$APP_ENV:production}_cors
	import {$APP_ENV:production}_auth

	# Bezpieczne nagłówki dla PWA
	header {
		# HSTS — agresywne, bo domena obsługiwana przez Cloudflare
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		# Anty-clickjacking
		X-Frame-Options "SAMEORIGIN"
		# MIME sniffing
		X-Content-Type-Options "nosniff"
		# Referrer
		Referrer-Policy "strict-origin-when-cross-origin"
		# Permissions
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
	}

	# --- Healthcheck (prosto do API, krótka ścieżka) ---
	handle /health* {
		reverse_proxy api:8000
	}

	# --- API + PMTiles ---
	# Wszystko pod /api/* leci do backendu.
	# PMTiles wymaga pełnego wsparcia HTTP Range (header_down + transparent).
	handle /api/* {
		reverse_proxy api:8000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			# Ważne: bez buforowania odpowiedzi, streaming
			flush_interval -1
			# Dłuższy timeout dla dużych plików PMTiles
			transport http {
				response_header_timeout 60s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	# --- Frontend PWA (wszystko inne) ---
	handle {
		reverse_proxy web:80 {
			header_up Host {host}
			# Tryb PWA: agresywne cache dla zbudowanych assetów
			# Nagłówki cache pochodzą z nginx (immutable/no-cache per asset class);
			# nadpisywanie ich tutaj psuło no-cache dla index.html → browser wisi
			# na starym bundle (znalezione we wdrożeniu na srv01).
		}
	}

	log {
		output stdout
		format console
	}
}
