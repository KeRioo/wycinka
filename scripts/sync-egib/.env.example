# EGiB sync — konfiguracja
# Skopiuj do .env i uzupełnij.

# Katalog bazowy dla wygenerowanych artefaktów (relatywny do CWD lub bezwzględny).
EGIB_DATA_DIR=./data

# Limity pobierania
EGIB_DOWNLOAD__CONCURRENCY=10
EGIB_DOWNLOAD__TIMEOUT_SECONDS=30
EGIB_DOWNLOAD__MAX_RETRIES=3
EGIB_DOWNLOAD__BACKOFF_BASE_SECONDS=1.0
EGIB_DOWNLOAD__BACKOFF_MAX_SECONDS=60.0

# Sciezka do tippecanoe (opcjonalnie; domyslnie "tippecanoe" z PATH)
EGIB_PMTILES__TIPPECANOE_PATH=tippecanoe
EGIB_PMTILES__MIN_ZOOM=4
EGIB_PMTILES__MAX_ZOOM=18
EGIB_PMTILES__BASE_ZOOM=14

# Batch insert do SQLite
EGIB_SQLITE__BATCH_SIZE=1000

# Zrodlo danych (URL pattern z geoportal.gov.pl)
EGIB_SOURCES__POWIAT_LIST_URL=https://integracja.gugik.gov.pl/cgi-bin/KrajowaIntegracjaEwidencjiGruntow
EGIB_SOURCES__GPKG_TEMPLATE=https://opendata.geoportal.gov.pl/{teryt}/egib.gpkg

# Retention: ile backupow zachowac
EGIB_RETENTION__BACKUPS_KEEP=2